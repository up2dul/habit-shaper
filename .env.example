# Browser-facing service addresses
WEB_PORT=5173
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
# Docker builds send browser API requests through the web server's same-origin proxy.
VITE_API_URL=/api

# Local MySQL bootstrap credentials
MYSQL_DATABASE=habit_shaper
MYSQL_USER=habit_shaper
MYSQL_PASSWORD=habit_shaper
MYSQL_ROOT_PASSWORD=local_root_password
